{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Intent Distortions redacted public artifacts: private immutable S3, CloudFront OAC, separate read/write policies. No users or access keys are created.",
  "Resources": {
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {"Status": "Enabled"},
        "ObjectLockEnabled": true,
        "ObjectLockConfiguration": {"ObjectLockEnabled": "Enabled", "Rule": {"DefaultRetention": {"Mode": "COMPLIANCE", "Days": 3650}}},
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true},
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]}
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {"OriginAccessControlConfig": {"Name": {"Fn::Sub": "${AWS::StackName}-artifacts"}, "OriginAccessControlOriginType": "s3", "SigningBehavior": "always", "SigningProtocol": "sigv4"}}
    },
    "CDN": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {"DistributionConfig": {
        "Enabled": true, "HttpVersion": "http2and3", "PriceClass": "PriceClass_100",
        "Origins": [{"Id": "artifacts", "DomainName": {"Fn::GetAtt": ["Artifacts", "RegionalDomainName"]}, "OriginAccessControlId": {"Ref": "OriginAccess"}, "S3OriginConfig": {"OriginAccessIdentity": ""}}],
        "DefaultCacheBehavior": {"TargetOriginId": "artifacts", "ViewerProtocolPolicy": "redirect-to-https", "AllowedMethods": ["GET", "HEAD"], "CachedMethods": ["GET", "HEAD"], "Compress": true, "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6"},
        "ViewerCertificate": {"CloudFrontDefaultCertificate": true}
      }}
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {"Bucket": {"Ref": "Artifacts"}, "PolicyDocument": {"Version": "2012-10-17", "Statement": [
        {"Sid": "PublicRedactedArtifactsViaCDN", "Effect": "Allow", "Principal": {"Service": "cloudfront.amazonaws.com"}, "Action": "s3:GetObject", "Resource": {"Fn::Sub": "${Artifacts.Arn}/sha256/*"}, "Condition": {"StringEquals": {"AWS:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${CDN}"}}}},
        {"Sid": "RequireTLS", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["Artifacts", "Arn"]}, {"Fn::Sub": "${Artifacts.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}},
        {"Sid": "RequireWriteOnceKeys", "Effect": "Deny", "Principal": "*", "Action": "s3:PutObject", "Resource": {"Fn::Sub": "${Artifacts.Arn}/sha256/*"}, "Condition": {"Null": {"s3:if-none-match": "true"}}}
      ]}}
    },
    "ReaderPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {"Description": "API artifact reads; no writes or deletes", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
        {"Effect": "Allow", "Action": "s3:GetObject", "Resource": {"Fn::Sub": "${Artifacts.Arn}/sha256/*"}},
        {"Effect": "Allow", "Action": ["s3:GetBucketVersioning", "s3:GetBucketObjectLockConfiguration"], "Resource": {"Fn::GetAtt": ["Artifacts", "Arn"]}}
      ]}}
    },
    "WriterPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {"Description": "Worker artifact read + conditional write; no deletes or bypass retention", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
        {"Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"], "Resource": {"Fn::Sub": "${Artifacts.Arn}/sha256/*"}},
        {"Effect": "Allow", "Action": ["s3:GetBucketVersioning", "s3:GetBucketObjectLockConfiguration"], "Resource": {"Fn::GetAtt": ["Artifacts", "Arn"]}}
      ]}}
    }
  },
  "Outputs": {
    "Bucket": {"Value": {"Ref": "Artifacts"}},
    "ArtifactPublicURL": {"Value": {"Fn::Sub": "https://${CDN.DomainName}"}},
    "ReaderPolicyARN": {"Value": {"Ref": "ReaderPolicy"}},
    "WriterPolicyARN": {"Value": {"Ref": "WriterPolicy"}}
  }
}
