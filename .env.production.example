# Copy to .env.production for local operator commands. Never commit the real file.
# The cloud uses service-scoped variables / mounted secrets instead.
APP_ENV=production
EXECUTION_MODE=live
SERVICE_ROLE=api
ECHOES_ROOT=.
DATABASE_URL=postgresql+psycopg://echoes:REPLACE@HOST:5432/echoes
DATA_DIR=./data/production-cache
PUBLIC_ORIGIN=https://YOUR-PRODUCTION-DOMAIN
CORS_ORIGIN=https://YOUR-PRODUCTION-DOMAIN
ALLOWED_HOSTS=["echoes-api.internal","localhost","127.0.0.1"]
ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PROTOCOL_ID=near-echoes-testnet-v1
# Choose a future Sunday and a genesis checkpoint before it, before the first worker starts.
# These and the other published policy fields cannot change in the same database.
FIRST_RELEASE_SUNDAY=2026-11-22
GENESIS_CHECKPOINT=1794700800
RECONCILIATION_DELAY_SECONDS=3600
FREEZE_OBSERVATION_MAX_AGE_SECONDS=3600
ALLOW_AI_FALLBACK=false
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_MAINNET_RPC_URL=https://YOUR-ARCHIVAL-MAINNET-RPC
NEAR_NFT_CONTRACT=YOUR-NFT.testnet
NEAR_AUCTION_CONTRACT=YOUR-AUCTION.testnet
NEAR_MINTER_ACCOUNT=YOUR-WORKER.testnet
EXPECTED_NFT_CODE_HASH=REPLACE_WITH_REVIEWED_WASM_SHA256_HEX
EXPECTED_AUCTION_CODE_HASH=REPLACE_WITH_REVIEWED_WASM_SHA256_HEX
NEAR_AI_TEXT_MODEL=REPLACE_WITH_AVAILABLE_NEAR_AI_MODEL_ID
STORAGE_PROVIDER=s3
S3_BUCKET=YOUR-ARTIFACT-BUCKET
S3_REGION=us-east-1
ARTIFACT_PUBLIC_URL=https://YOUR-CLOUDFRONT-DOMAIN
# Give the API a read-only credential; the worker gets write-once PutObject + GetObject.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Worker only. Do not put these in the frontend or API service.
NEAR_INTENTS_PARTNER_JWT=
NEAR_AI_API_KEY=
SIGNER_KEY_FILE=/etc/secrets/near-worker.json
ENABLE_CHAIN_WRITES=false
MAINNET_WRITES_APPROVED=false
WORKER_POLL_SECONDS=30
INDEX_POLL_SECONDS=600
