# Copy to .env.replay and set ECHOES_ENV_FILE=.env.replay for historical test commands.
# The runner overrides database/storage/signing settings with an isolated local profile.
APP_ENV=development
EXECUTION_MODE=historical_replay
NEAR_INTENTS_EXPLORER_URL=https://explorer.near-intents.org/api/v0
NEAR_INTENTS_PARTNER_JWT=
NEAR_MAINNET_RPC_URL=https://archival-rpc.mainnet.near.org
# Historical source blocks are mainnet; no transactions will be signed.
NEAR_NETWORK=mainnet
# Optional: used only with --ai required. Default --ai fallback makes no AI request.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_TEXT_MODEL=
ENABLE_CHAIN_WRITES=false
SCHEDULER_ENABLED=false
