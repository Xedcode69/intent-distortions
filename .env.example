APP_ENV=development
EXECUTION_MODE=demo
# SQLite is for local demo only. Docker Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./data/echoes-demo.db
DATA_DIR=./data
ADMIN_TOKEN=
CORS_ORIGIN=http://localhost:3000
SCHEDULER_ENABLED=false
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_MAINNET_RPC_URL=https://archival-rpc.mainnet.near.org
NEAR_NFT_CONTRACT=
NEAR_AUCTION_CONTRACT=
NEAR_MINTER_ACCOUNT=
NEAR_SIGNER_REFERENCE=
NEAR_INTENTS_EXPLORER_URL=https://explorer.near-intents.org/api/v0
NEAR_INTENTS_PARTNER_JWT=
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Set to a current model ID returned by GET /v1/models. Never guessed by the worker.
NEAR_AI_TEXT_MODEL=
NEAR_AI_IMAGE_MODEL=
DRAND_NETWORK=default
DRAND_CHAIN_HASH=8990e7a9aaed2ffed73dbd7092123d6f289930540d7651336225dc172e51b2ce
DRAND_API_URL=https://api.drand.sh
# Network, key and schedule are code-pinned for v1; env cannot override trust roots.
EPOCH_SELECTION_HOUR_UTC=18
EPOCH_SELECTION_WINDOW_START_UTC=0
EPOCH_SELECTION_WINDOW_END_UTC=17
GENESIS_CHECKPOINT=1793491200
RECONCILIATION_DELAY_SECONDS=3600
GENERATION_MODE=mathematical
ART_RENDERER_VERSION=1
STORAGE_PROVIDER=local_content_addressed
IPFS_API_KEY=
AUCTION_DURATION_HOURS=168
AUCTION_MIN_BID=1000000000000000000000000
AUCTION_MIN_INCREMENT=100000000000000000000000
# Frontend server-only proxy target; no secret gets a NEXT_PUBLIC_ prefix.
BACKEND_URL=http://127.0.0.1:8000
