# Reference for the editable fields in the GENERATED
# data/testnet-rehearsals/full-lab/profile.env. Do not replace its isolated paths.
# All accounts must already exist on testnet and have sufficient storage/gas funds.
TESTNET_GOVERNANCE_ACCOUNT=governance.YOUR-LAB.testnet
NEAR_MINTER_ACCOUNT=operator.YOUR-LAB.testnet
NEAR_CREATOR_ACCOUNT=team.YOUR-LAB.testnet
NEAR_TREASURY_ACCOUNT=treasury.YOUR-LAB.testnet
NEAR_NFT_CONTRACT=nft.YOUR-LAB.testnet
NEAR_AUCTION_CONTRACT=auction.YOUR-LAB.testnet
NEAR_MARKET_CONTRACT=market.YOUR-LAB.testnet
# Upload only the workspace's public/ directory to this HTTPS prefix.
TESTNET_ARTIFACT_BASE_URL=https://YOUR-PUBLIC-HOST/genesis
# Optional private testnet RPC. It remains on the backend/operator side.
NEAR_RPC_URL=https://rpc.testnet.near.org
